    // =========================================================================
    // СОСТОЯНИЕ ПРИЛОЖЕНИЯ (STATE) И LOCALSTORAGE
    // =========================================================================
    const STORAGE_KEYS = {
      GRADE: 'freshstudy_grade',
      COMPLETED: 'freshstudy_completed_topics',
      SCORES: 'freshstudy_topic_scores'
    };

    let state = {
      grade: localStorage.getItem(STORAGE_KEYS.GRADE) || null,
      completedTopics: JSON.parse(localStorage.getItem(STORAGE_KEYS.COMPLETED) || '[]'),
      topicScores: JSON.parse(localStorage.getItem(STORAGE_KEYS.SCORES) || '{}'),
      view: 'onboarding', // 'onboarding' | 'subjects' | 'topics' | 'lesson'
      selectedSubjectId: null,
      selectedTopicId: null,
      // Состояние текущего тренажера
      quiz: {
        currentIndex: 0,
        score: 0,
        answered: false,
        lastCorrect: false,
        userAnswerDisplay: '',
        finished: false
      }
    };

    // Инициализация при запуске
    function initApp() {
      if (state.grade === '8') {
        state.view = 'subjects';
      } else {
        state.view = 'onboarding';
      }
      render();
    }

    // Сохранение прогресса
    function saveProgress() {
      localStorage.setItem(STORAGE_KEYS.COMPLETED, JSON.stringify(state.completedTopics));
      localStorage.setItem(STORAGE_KEYS.SCORES, JSON.stringify(state.topicScores));
      updateHeaderStats();
    }

    // Подсчёт общего числа тем
    function getTotalTopicsCount() {
      return CURRICULUM_8.reduce((acc, subj) => acc + subj.topics.length, 0);
    }

    // Обновление счетчиков в шапке
    function updateHeaderStats() {
      const header = document.getElementById('app-header');
      if (state.view === 'onboarding' || !state.grade) {
        header.classList.add('hidden');
        return;
      }
      header.classList.remove('hidden');
      document.getElementById('header-grade-badge').textContent = `${state.grade} класс`;
      document.getElementById('header-progress-count').textContent = state.completedTopics.length;
      document.getElementById('header-total-topics').textContent = getTotalTopicsCount();
    }

    // Всплывающее уведомление (замена alert)
    function showToast(message, type = 'info') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      
      const styles = {
        info: 'bg-slate-900 text-white border-slate-700',
        success: 'bg-emerald-600 text-white border-emerald-500',
        warning: 'bg-indigo-600 text-white border-indigo-500'
      };

      const icon = type === 'success'
        ? `<svg class="w-5 h-5 shrink-0 text-emerald-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>`
        : `<svg class="w-5 h-5 shrink-0 text-indigo-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>`;

      toast.className = `pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-2xl shadow-xl border text-sm font-medium animate-pop ${styles[type] || styles.info}`;
      toast.innerHTML = `${icon}<span>${message}</span>`;

      container.appendChild(toast);

      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(8px)';
        toast.style.transition = 'all 0.25s ease';
        setTimeout(() => toast.remove(), 250);
      }, 2800);
    }

    // =========================================================================
    // НАВИГАЦИЯ
    // =========================================================================
    function selectGrade(gradeNum) {
      if (gradeNum !== 8) {
        showToast('Этот класс скоро появится! Сейчас доступен 8 класс', 'warning');
        return;
      }
      state.grade = '8';
      localStorage.setItem(STORAGE_KEYS.GRADE, '8');
      state.view = 'subjects';
      showToast('Отлично! Выбран 8 класс', 'success');
      render();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function openGradeSelector() {
      state.view = 'onboarding';
      render();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function navigateHome() {
      if (!state.grade) {
        state.view = 'onboarding';
      } else {
        state.view = 'subjects';
        state.selectedSubjectId = null;
        state.selectedTopicId = null;
      }
      render();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function openSubject(subjectId) {
      state.selectedSubjectId = subjectId;
      state.view = 'topics';
      render();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function openTopic(subjectId, topicId) {
      state.selectedSubjectId = subjectId;
      state.selectedTopicId = topicId;
      state.view = 'lesson';
      resetQuizState();
      render();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function resetQuizState() {
      state.quiz = {
        currentIndex: 0,
        score: 0,
        answered: false,
        lastCorrect: false,
        userAnswerDisplay: '',
        finished: false
      };
    }

    // =========================================================================
    // ЛОГИКА ТРЕНАЖЁРА
    // =========================================================================
    function getCurrentTopic() {
      const subj = CURRICULUM_8.find(s => s.id === state.selectedSubjectId);
      if (!subj) return null;
      return subj.topics.find(t => t.id === state.selectedTopicId);
    }

    function handleChoiceAnswer(optionIndex) {
      if (state.quiz.answered) return;
      const topic = getCurrentTopic();
      const question = topic.questions[state.quiz.currentIndex];
      const isCorrect = optionIndex === question.answer;

      state.quiz.answered = true;
      state.quiz.lastCorrect = isCorrect;
      state.quiz.selectedOption = optionIndex;
      if (isCorrect) state.quiz.score++;

      renderQuizSection();
    }

    function handleInputAnswer(event) {
      if (event) event.preventDefault();
      if (state.quiz.answered) return;

      const inputEl = document.getElementById('quiz-text-input');
      if (!inputEl) return;

      const rawVal = inputEl.value.trim().toLowerCase().replace(',', '.');
      if (!rawVal) {
        showToast('Введи ответ перед проверкой!', 'info');
        inputEl.focus();
        return;
      }

      const topic = getCurrentTopic();
      const question = topic.questions[state.quiz.currentIndex];
      const normalizedValid = question.correctText.map(v => v.trim().toLowerCase().replace(',', '.'));
      const isCorrect = normalizedValid.includes(rawVal);

      state.quiz.answered = true;
      state.quiz.lastCorrect = isCorrect;
      state.quiz.userAnswerDisplay = inputEl.value.trim();
      if (isCorrect) state.quiz.score++;

      renderQuizSection();
    }

    function nextQuizQuestion() {
      const topic = getCurrentTopic();
      if (state.quiz.currentIndex + 1 < topic.questions.length) {
        state.quiz.currentIndex++;
        state.quiz.answered = false;
        state.quiz.lastCorrect = false;
        state.quiz.selectedOption = null;
        state.quiz.userAnswerDisplay = '';
      } else {
        state.quiz.finished = true;
        // Сохраняем лучший результат по теме
        const prevBest = state.topicScores[topic.id] || 0;
        if (state.quiz.score > prevBest) {
          state.topicScores[topic.id] = state.quiz.score;
        }
        // Если набрано >= 70%, автоматически предлагаем или отмечаем изученным
        if (state.quiz.score / topic.questions.length >= 0.7 && !state.completedTopics.includes(topic.id)) {
          state.completedTopics.push(topic.id);
          showToast('Тема автоматически отмечена как изученная!', 'success');
        }
        saveProgress();
      }
      renderQuizSection();
    }

    function restartQuiz() {
      resetQuizState();
      renderQuizSection();
    }

    function toggleTopicCompleted(topicId) {
      const idx = state.completedTopics.indexOf(topicId);
      if (idx === -1) {
        state.completedTopics.push(topicId);
        showToast('Тема отмечена как изученная!', 'success');
      } else {
        state.completedTopics.splice(idx, 1);
        showToast('Отметка об изучении снята', 'info');
      }
      saveProgress();
      render();
    }

    // =========================================================================
    // РЕНДЕР ЭКРАНОВ
    // =========================================================================
    function render() {
      updateHeaderStats();
      const root = document.getElementById('app-root');

      if (state.view === 'onboarding') {
        root.innerHTML = renderOnboardingView();
      } else if (state.view === 'subjects') {
        root.innerHTML = renderSubjectsView();
      } else if (state.view === 'topics') {
        root.innerHTML = renderTopicsView();
      } else if (state.view === 'lesson') {
        root.innerHTML = renderLessonView();
      }
    }

    // 1. ЭКРАН ВЫБОРА КЛАССА (ONBOARDING)
    function renderOnboardingView() {
      const grades = [5, 6, 7, 8, 9, 10, 11];
      const buttonsHtml = grades.map(g => {
        const isEighth = g === 8;
        if (isEighth) {
          return `
            <button onclick="selectGrade(8)" class="relative group flex flex-col items-center justify-center p-5 sm:p-6 rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-600 text-white shadow-lg shadow-emerald-500/25 hover:shadow-emerald-500/40 hover:-translate-y-0.5 active:scale-95 transition-all cursor-pointer border-2 border-emerald-400">
              <span class="absolute -top-2.5 right-3 bg-indigo-600 text-white text-[10px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full shadow-sm">
                Доступно
              </span>
              <span class="text-3xl sm:text-4xl font-extrabold tracking-tight">${g}</span>
              <span class="text-xs sm:text-sm font-semibold text-emerald-50 mt-1">класс</span>
            </button>
          `;
        } else {
          return `
            <button onclick="selectGrade(${g})" class="relative flex flex-col items-center justify-center p-5 sm:p-6 rounded-2xl bg-white text-slate-400 border border-slate-200/90 hover:border-slate-300 hover:bg-slate-50/80 active:scale-95 transition-all cursor-pointer">
              <span class="absolute -top-2.5 right-2.5 bg-slate-100 text-slate-500 border border-slate-200 text-[10px] font-semibold px-2 py-0.5 rounded-full">
                Скоро
              </span>
              <span class="text-3xl sm:text-4xl font-bold text-slate-500">${g}</span>
              <span class="text-xs sm:text-sm font-medium text-slate-400 mt-1">класс</span>
            </button>
          `;
        }
      }).join('');

      return `
        <div class="min-h-[78vh] flex flex-col items-center justify-center animate-view py-4">
          <div class="w-full max-w-2xl bg-white rounded-3xl p-6 sm:p-10 shadow-sm border border-slate-200/80 text-center">
            <!-- Бейдж бренда -->
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-50 text-indigo-700 text-xs font-semibold mb-5 border border-indigo-100">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              FreshStudy • Помощник к электронному дневнику
            </div>

            <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
              Выбери свой класс, чтобы начать подготовку
            </h1>
            <p class="text-slate-500 text-sm sm:text-base mt-3 max-w-lg mx-auto leading-relaxed">
              Краткие конспекты без воды, запоминалки с рифмами и быстрые тренажёры на 10–12 задач перед контрольной или уроком.
            </p>

            <!-- Сетка классов -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3.5 sm:gap-4 mt-8">
              ${buttonsHtml}
            </div>

            <p class="text-xs text-slate-400 mt-7">
              Выбор сохранится автоматически — ты всегда сможешь изменить класс в шапке сайта.
            </p>
          </div>
        </div>
      `;
    }

    // 2. ГЛАВНЫЙ ЭКРАН — ВЫБОР ПРЕДМЕТА
    function renderSubjectsView() {
      const completedCount = state.completedTopics.length;
      const totalCount = getTotalTopicsCount();
      const progressPercent = Math.round((completedCount / totalCount) * 100);

      const cardsHtml = CURRICULUM_8.map(subj => {
        const subjCompleted = subj.topics.filter(t => state.completedTopics.includes(t.id)).length;
        const subjTotal = subj.topics.length;
        const allDone = subjCompleted === subjTotal && subjTotal > 0;

        return `
          <button onclick="openSubject('${subj.id}')" class="group text-left bg-white rounded-2xl p-5 sm:p-6 border border-slate-200/80 ${subj.borderHover} shadow-sm hover:shadow-md hover:-translate-y-0.5 active:scale-[0.99] transition-all flex flex-col justify-between cursor-pointer">
            <div>
              <div class="flex items-start justify-between gap-3">
                <div class="w-12 h-12 rounded-2xl ${subj.iconBg} flex items-center justify-center shadow-sm group-hover:scale-105 transition-transform">
                  ${subj.iconSvg}
                </div>
                <span class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded-full ${allDone ? 'bg-emerald-100 text-emerald-700' : `${subj.badgeBg} ${subj.badgeText}`}">
                  ${allDone ? '✓ Всё изучено' : `${subjCompleted} из ${subjTotal} тем`}
                </span>
              </div>

              <h2 class="text-lg sm:text-xl font-bold text-slate-900 mt-4 group-hover:text-indigo-700 transition-colors">
                ${subj.name}
              </h2>
              <p class="text-sm text-slate-500 mt-1.5 leading-relaxed">
                ${subj.description}
              </p>
            </div>

            <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-slate-500 group-hover:text-indigo-600 transition-colors">
              <span>Открыть темы</span>
              <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </div>
          </button>
        `;
      }).join('');

      return `
        <div class="animate-view">
          <!-- Приветственный баннер с прогрессом -->
          <div class="bg-gradient-to-r from-indigo-600 via-indigo-700 to-slate-900 rounded-3xl p-6 sm:p-8 text-white shadow-md mb-7 relative overflow-hidden">
            <div class="relative z-10 flex flex-col sm:flex-row sm:items-center justify-between gap-6">
              <div>
                <div class="inline-flex items-center gap-2 bg-white/15 backdrop-blur-sm px-3 py-1 rounded-full text-xs font-semibold text-emerald-300 mb-3">
                  <span>Программа 8 класса</span>
                </div>
                <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
                  К какому уроку готовимся сегодня?
                </h1>
                <p class="text-indigo-100 text-sm sm:text-base mt-1.5 max-w-xl">
                  Выбери предмет, пробегись по мини-конспекту с рифмой и закрепи материал на задачах.
                </p>
              </div>

              <!-- Виджет общего прогресса -->
              <div class="bg-white/10 backdrop-blur-md border border-white/15 rounded-2xl p-4 sm:min-w-[210px]">
                <div class="flex items-center justify-between text-xs font-semibold text-indigo-100 mb-2">
                  <span>Твой прогресс</span>
                  <span class="text-emerald-300 font-bold">${progressPercent}%</span>
                </div>
                <div class="w-full h-2.5 bg-slate-900/40 rounded-full overflow-hidden">
                  <div class="h-full bg-gradient-to-r from-emerald-400 to-teal-300 rounded-full transition-all duration-500" style="width: ${progressPercent}%"></div>
                </div>
                <div class="text-xs text-indigo-200 mt-2">
                  Изучено <b class="text-white">${completedCount}</b> из <b class="text-white">${totalCount}</b> тем
                </div>
              </div>
            </div>
          </div>

          <!-- Сетка предметов -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
            ${cardsHtml}
          </div>
        </div>
      `;
    }

    // 3. ЭКРАН СПИСКА ТЕМ ВЫБРАННОГО ПРЕДМЕТА
    function renderTopicsView() {
      const subject = CURRICULUM_8.find(s => s.id === state.selectedSubjectId);
      if (!subject) return navigateHome();

      const topicsHtml = subject.topics.map((topic, index) => {
        const isDone = state.completedTopics.includes(topic.id);
        const bestScore = state.topicScores[topic.id];
        const totalQ = topic.questions.length;

        return `
          <div onclick="openTopic('${subject.id}', '${topic.id}')" class="group bg-white rounded-2xl p-5 sm:p-6 border ${isDone ? 'border-emerald-200 bg-emerald-50/20' : 'border-slate-200/80'} hover:border-indigo-300 shadow-sm hover:shadow-md transition-all cursor-pointer flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl ${isDone ? 'bg-emerald-500 text-white' : 'bg-slate-100 text-slate-600 group-hover:bg-indigo-600 group-hover:text-white'} font-bold text-sm flex items-center justify-center shrink-0 transition-colors">
                ${isDone ? '✓' : index + 1}
              </div>
              <div>
                <div class="flex flex-wrap items-center gap-2 mb-1">
                  <span class="text-xs font-medium text-slate-400">⏱ ${topic.readTime}</span>
                  <span class="text-slate-300">•</span>
                  <span class="text-xs font-medium text-indigo-600">${totalQ} задач в тренажёре</span>
                  ${isDone ? `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-100 text-emerald-700">Изучена</span>` : ''}
                </div>
                <h3 class="text-base sm:text-lg font-bold text-slate-900 group-hover:text-indigo-700 transition-colors">
                  ${topic.title}
                </h3>
                ${bestScore !== undefined ? `
                  <p class="text-xs font-medium text-slate-500 mt-1.5">
                    Лучший результат в тренажёре: <span class="font-bold text-emerald-600">${bestScore} из ${totalQ}</span>
                  </p>
                ` : `
                  <p class="text-xs text-slate-400 mt-1.5">Тренажёр ещё не пройден</p>
                `}
              </div>
            </div>

            <div class="flex items-center justify-end sm:justify-center shrink-0">
              <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-slate-100 group-hover:bg-indigo-600 text-slate-700 group-hover:text-white text-xs sm:text-sm font-semibold transition-colors">
                <span>Открыть</span>
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </span>
            </div>
          </div>
        `;
      }).join('');

      return `
        <div class="animate-view max-w-3xl mx-auto">
          <!-- Хлебные крошки / Назад -->
          <button onclick="navigateHome()" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-500 hover:text-indigo-600 mb-5 py-1.5 px-3 -ml-3 rounded-xl hover:bg-slate-100 transition-colors cursor-pointer">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            <span>Все предметы</span>
          </button>

          <!-- Заголовок предмета -->
          <div class="flex items-center gap-4 mb-6">
            <div class="w-14 h-14 rounded-2xl ${subject.iconBg} flex items-center justify-center shadow-sm shrink-0">
              ${subject.iconSvg}
            </div>
            <div>
              <span class="text-xs font-bold uppercase tracking-wider ${subject.badgeText}">8 класс • Предмет</span>
              <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900">${subject.name}</h1>
              <p class="text-sm text-slate-500 mt-0.5">${subject.description}</p>
            </div>
          </div>

          <!-- Список тем -->
          <div class="space-y-3.5">
            ${topicsHtml}
          </div>
        </div>
      `;
    }

    // 4. ЭКРАН УЧЕБНОГО МОДУЛЯ (КОНСПЕКТ + РИФМА + ТРЕНАЖЁР)
    function renderLessonView() {
      const subject = CURRICULUM_8.find(s => s.id === state.selectedSubjectId);
      const topic = getCurrentTopic();
      if (!subject || !topic) return navigateHome();

      const isDone = state.completedTopics.includes(topic.id);

      // Рендер блоков мини-конспекта
      const summaryBlocksHtml = topic.summary.map(block => `
        <div class="bg-slate-50/90 rounded-2xl p-4 sm:p-5 border border-slate-200/70">
          <h3 class="text-sm sm:text-base font-bold text-slate-900 mb-2 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
            ${block.heading}
          </h3>
          ${block.text ? `<p class="text-sm text-slate-700 leading-relaxed">${block.text}</p>` : ''}
          ${block.list ? `
            <ul class="space-y-2 mt-2 text-sm text-slate-700">
              ${block.list.map(item => `
                <li class="flex items-start gap-2.5 leading-relaxed">
                  <span class="text-emerald-500 font-bold mt-0.5">•</span>
                  <span>${item}</span>
                </li>
              `).join('')}
            </ul>
          ` : ''}
        </div>
      `).join('');

      // Рендер строк рифмы
      const rhymeLinesHtml = topic.rhyme.lines.map(line => `
        <p class="text-sm sm:text-base font-medium text-amber-950 leading-relaxed">${line}</p>
      `).join('');

      return `
        <div class="animate-view max-w-3xl mx-auto space-y-6 pb-10">
          <!-- Навигация назад -->
          <div class="flex flex-wrap items-center justify-between gap-3">
            <button onclick="openSubject('${subject.id}')" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-600 hover:text-indigo-600 py-2 px-3.5 -ml-3 rounded-xl hover:bg-white border border-transparent hover:border-slate-200 transition-all cursor-pointer">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M19 12H5M12 19l-7-7 7-7"/>
              </svg>
              <span>Назад к темам (${subject.name})</span>
            </button>

            <button onclick="toggleTopicCompleted('${topic.id}')" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all cursor-pointer ${
              isDone
                ? 'bg-emerald-100 text-emerald-800 border border-emerald-300 hover:bg-emerald-200/70'
                : 'bg-white text-slate-700 border border-slate-200 hover:border-emerald-400 hover:text-emerald-700'
            }">
              <span>${isDone ? '✓ Тема изучена' : 'Отметить изученной'}</span>
            </button>
          </div>

          <!-- Шапка темы -->
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold ${subject.badgeBg} ${subject.badgeText} mb-2">
              <span>${subject.name} • 8 класс</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
              ${topic.title}
            </h1>
          </div>

          <!-- БЛОК 1: МИНИ-КОНСПЕКТ -->
          <section class="bg-white rounded-3xl p-5 sm:p-7 shadow-sm border border-slate-200/80">
            <div class="flex items-center gap-2.5 mb-4">
              <div class="w-9 h-9 rounded-xl bg-indigo-100 text-indigo-600 flex items-center justify-center">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                  <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-lg font-bold text-slate-900">Мини-конспект</h2>
                <p class="text-xs text-slate-400">Только главное для быстрого повторения</p>
              </div>
            </div>

            <div class="space-y-3.5">
              ${summaryBlocksHtml}
            </div>
          </section>

          <!-- БЛОК 2: ЗАПОМИНАЛКА С РИФМОЙ -->
          <section class="bg-gradient-to-br from-amber-50 via-yellow-50 to-orange-50 rounded-3xl p-5 sm:p-7 border-2 border-amber-200/80 shadow-sm relative overflow-hidden">
            <div class="flex items-center gap-2.5 mb-3">
              <div class="w-9 h-9 rounded-xl bg-amber-400/30 text-amber-800 flex items-center justify-center">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <path d="M9 18V5l12-2v13"/>
                  <circle cx="6" cy="18" r="3"/>
                  <circle cx="18" cy="16" r="3"/>
                </svg>
              </div>
              <div>
                <span class="text-[11px] font-bold uppercase tracking-wider text-amber-700">Мнемоника • Легко запомнить</span>
                <h2 class="text-base sm:text-lg font-extrabold text-amber-950">${topic.rhyme.title}</h2>
              </div>
            </div>

            <div class="bg-white/75 backdrop-blur-sm rounded-2xl p-4 sm:p-5 border border-amber-200/60 space-y-1">
              ${rhymeLinesHtml}
            </div>
          </section>

          <!-- БЛОК 3: ИНТЕРАКТИВНЫЙ ТРЕНАЖЁР -->
          <section id="quiz-container" class="bg-white rounded-3xl p-5 sm:p-7 shadow-sm border border-slate-200/80">
            ${getQuizInnerHtml(topic)}
          </section>
        </div>
      `;
    }

    // Обновление только блока тренажёра без перерисовки всей страницы
    function renderQuizSection() {
      const topic = getCurrentTopic();
      const container = document.getElementById('quiz-container');
      if (container && topic) {
        container.innerHTML = getQuizInnerHtml(topic);
      }
    }

    // Генерация HTML для блока тренажёра
    function getQuizInnerHtml(topic) {
      const total = topic.questions.length;
      const qState = state.quiz;

      // ЭКРАН РЕЗУЛЬТАТОВ ТРЕНАЖЁРА
      if (qState.finished) {
        const percent = Math.round((qState.score / total) * 100);
        const isDone = state.completedTopics.includes(topic.id);

        let verdictTitle = 'Хорошая попытка!';
        let verdictSub = 'Пробегись ещё раз по конспекту и попробуй улучшить результат.';
        let badgeColor = 'bg-amber-100 text-amber-800';

        if (percent >= 80) {
          verdictTitle = 'Отличный результат! 🔥';
          verdictSub = 'Ты полностью готов к опросу или контрольной по этой теме!';
          badgeColor = 'bg-emerald-100 text-emerald-800';
        } else if (percent >= 50) {
          verdictTitle = 'Неплохо! 👍';
          verdictSub = 'База усвоена, но стоит закрепить пару моментов.';
          badgeColor = 'bg-indigo-100 text-indigo-800';
        }

        return `
          <div class="text-center py-4 animate-pop">
            <div class="inline-flex items-center px-3.5 py-1 rounded-full text-xs font-bold ${badgeColor} mb-3">
              Тренировка завершена • ${percent}%
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">${verdictTitle}</h2>
            <p class="text-sm text-slate-500 mt-1.5 max-w-md mx-auto">${verdictSub}</p>

            <div class="my-6 inline-flex items-baseline gap-2 bg-slate-50 px-6 py-4 rounded-2xl border border-slate-200">
              <span class="text-4xl font-extrabold text-indigo-600">${qState.score}</span>
              <span class="text-lg font-semibold text-slate-400">из ${total} правильных</span>
            </div>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mt-2">
              <button onclick="restartQuiz()" class="w-full sm:w-auto px-5 py-3 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold text-sm transition-colors cursor-pointer">
                ↻ Пройти заново
              </button>
              <button onclick="toggleTopicCompleted('${topic.id}')" class="w-full sm:w-auto px-5 py-3 rounded-xl font-semibold text-sm transition-all cursor-pointer ${
                isDone
                  ? 'bg-emerald-600 text-white hover:bg-emerald-700'
                  : 'bg-indigo-600 text-white hover:bg-indigo-700 shadow-sm'
              }">
                ${isDone ? '✓ Тема отмечена изученной' : 'Отметить тему изученной'}
              </button>
            </div>
          </div>
        `;
      }

      // ТЕКУЩАЯ ЗАДАЧА
      const currentQ = topic.questions[qState.currentIndex];
      const progressPct = Math.round(((qState.currentIndex + (qState.answered ? 1 : 0)) / total) * 100);

      let interactionHtml = '';

      if (currentQ.type === 'choice') {
        interactionHtml = `
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-4">
            ${currentQ.options.map((opt, idx) => {
              let btnStyle = 'bg-slate-50 hover:bg-indigo-50/70 border-slate-200 hover:border-indigo-300 text-slate-800';
              let badgeStyle = 'bg-white text-slate-500 border-slate-200';

              if (qState.answered) {
                if (idx === currentQ.answer) {
                  btnStyle = 'bg-emerald-50 border-emerald-500 text-emerald-950 font-semibold';
                  badgeStyle = 'bg-emerald-500 text-white border-emerald-500';
                } else if (idx === qState.selectedOption && idx !== currentQ.answer) {
                  btnStyle = 'bg-rose-50 border-rose-400 text-rose-950';
                  badgeStyle = 'bg-rose-500 text-white border-rose-500';
                } else {
                  btnStyle = 'bg-slate-50/60 border-slate-200/60 text-slate-400 opacity-70';
                }
              }

              const letters = ['А', 'Б', 'В', 'Г'];
              return `
                <button
                  onclick="handleChoiceAnswer(${idx})"
                  ${qState.answered ? 'disabled' : ''}
                  class="text-left p-3.5 sm:p-4 rounded-2xl border-2 transition-all flex items-center gap-3 ${btnStyle} ${qState.answered ? 'cursor-default' : 'cursor-pointer active:scale-[0.99]'}">
                  <span class="w-7 h-7 rounded-lg border text-xs font-bold flex items-center justify-center shrink-0 ${badgeStyle}">
                    ${letters[idx] || idx + 1}
                  </span>
                  <span class="text-sm sm:text-base leading-snug">${opt}</span>
                </button>
              `;
            }).join('')}
          </div>
        `;
      } else {
        // Задача с вводом числа / короткого ответа
        const correctDisplay = currentQ.correctText[0];
        interactionHtml = `
          <form onsubmit="handleInputAnswer(event)" class="mt-4">
            <div class="flex flex-col sm:flex-row gap-3">
              <input
                id="quiz-text-input"
                type="text"
                autocomplete="off"
                placeholder="Введи ответ..."
                ${qState.answered ? `disabled value="${qState.userAnswerDisplay}"` : ''}
                class="flex-1 px-4 py-3.5 rounded-2xl border-2 text-base font-semibold focus:outline-none transition-colors ${
                  qState.answered
                    ? (qState.lastCorrect ? 'bg-emerald-50 border-emerald-500 text-emerald-900' : 'bg-rose-50 border-rose-400 text-rose-900')
                    : 'bg-slate-50 border-slate-200 focus:border-indigo-500 focus:bg-white text-slate-900'
                }"
              />
              ${!qState.answered ? `
                <button type="submit" class="px-6 py-3.5 rounded-2xl bg-indigo-600 hover:bg-indigo-700 active:scale-95 text-white font-semibold text-sm sm:text-base transition-all cursor-pointer shrink-0">
                  Проверить
                </button>
              ` : ''}
            </div>
            ${qState.answered && !qState.lastCorrect ? `
              <div class="mt-2.5 text-sm font-semibold text-emerald-700">
                Правильный ответ: <span class="bg-emerald-100 px-2.5 py-0.5 rounded-lg">${correctDisplay}</span>
              </div>
            ` : ''}
          </form>
        `;
      }

      // Блок пояснения после ответа
      const feedbackHtml = qState.answered ? `
        <div class="mt-5 p-4 rounded-2xl border animate-pop ${
          qState.lastCorrect
            ? 'bg-emerald-50/90 border-emerald-200 text-emerald-950'
            : 'bg-rose-50/90 border-rose-200 text-rose-950'
        }">
          <div class="flex items-center gap-2 font-bold text-sm mb-1">
            <span>${qState.lastCorrect ? '✅ Верно!' : '❌ Не совсем так'}</span>
          </div>
          <p class="text-xs sm:text-sm leading-relaxed opacity-90">
            ${currentQ.explanation}
          </p>
          <div class="mt-4 flex justify-end">
            <button onclick="nextQuizQuestion()" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 active:scale-95 text-white text-sm font-semibold transition-all cursor-pointer">
              <span>${qState.currentIndex + 1 < total ? 'Следующая задача' : 'Завершить и узнать результат'}</span>
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </button>
          </div>
        </div>
      ` : '';

      return `
        <div>
          <!-- Шапка тренажёра -->
          <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
            <div class="flex items-center gap-2.5">
              <div class="w-9 h-9 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <circle cx="12" cy="12" r="10"/>
                  <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
                  <line x1="12" y1="17" x2="12.01" y2="17"/>
                </svg>
              </div>
              <div>
                <h2 class="text-lg font-bold text-slate-900">Тренажёр задач</h2>
                <p class="text-xs text-slate-400">Задача ${qState.currentIndex + 1} из ${total}</p>
              </div>
            </div>

            <div class="text-xs font-bold px-3 py-1 rounded-full bg-slate-100 text-slate-700">
              Верно: <span class="text-emerald-600">${qState.score}</span>
            </div>
          </div>

          <!-- Прогресс-бар тренажёра -->
          <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden mb-5">
            <div class="h-full bg-gradient-to-r from-indigo-500 to-emerald-500 rounded-full transition-all duration-300" style="width: ${progressPct}%"></div>
          </div>

          <!-- Текст вопроса -->
          <div class="text-base sm:text-lg font-bold text-slate-900 leading-snug">
            ${currentQ.q}
          </div>

          <!-- Варианты ответа или поле ввода -->
          ${interactionHtml}

          <!-- Пояснение и кнопка «Далее» -->
          ${feedbackHtml}
        </div>
      `;
    }

    // Запуск приложения после загрузки DOM
    window.addEventListener('DOMContentLoaded', initApp);
  </script>
</body>
</html>
